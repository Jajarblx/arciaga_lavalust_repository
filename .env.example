# Copy this file to .env and update the values below

# Application Settings
APP_NAME=LavaLust Product Inventory
APP_KEY=
APP_ENV=development
APP_URL=http://localhost/ArciagaLavalust

# Database Configuration (supply your own values in .env)
DB_DRIVER=mysql
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4
DB_PREFIX=

# Managed MySQL SSL
DB_SSL_MODE=REQUIRED
DB_SSL_CA=certs/ca.pem
DB_SSL_VERIFY=true

# Container runtime (Render supplies this automatically)
PORT=
